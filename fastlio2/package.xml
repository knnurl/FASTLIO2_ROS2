<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fastlio2</name>
  <version>0.1.0</version>
  <description>FAST-LIO2 LiDAR-inertial odometry node (Livox CustomMsg or standard PointCloud2 input) with map saving.</description>
  <maintainer email="kaan549@gmail.com">Kaan Ural</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>livox_ros_driver2</depend>
  <depend>geometry_msgs</depend>
  <depend>interface</depend>

  <!-- System libraries linked directly in CMakeLists (rosdep keys) -->
  <depend>eigen</depend>
  <depend>libpcl-all-dev</depend>
  <depend>yaml-cpp</depend>
  <depend>sophus</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
